    "@askpdf/observability": "workspace:*",
    "@askpdf/queue": "workspace:*",
    "@askpdf/rag": "workspace:*",
    "@askpdf/storage": "workspace:*",
    "argon2": "0.45.1",
    "cookie": "2.0.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.10",
    "mongoose": "9.9.4",
    "pino-http": "11.0.0",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
